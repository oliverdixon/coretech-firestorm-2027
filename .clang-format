---
Language: Cpp
BasedOnStyle: LLVM
Standard: Latest

IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
ColumnLimit: 120

MaxEmptyLinesToKeep: 2
KeepEmptyLines:
  AtStartOfFile: false
  AtEndOfFile: false
  AtStartOfBlock: false

# Braces
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterStruct: true
  AfterUnion: true
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterControlStatement: Never
  BeforeElse: false
  BeforeCatch: false
  SplitEmptyFunction: true
  SplitEmptyRecord: false
  SplitEmptyNamespace: false

# Short constructs
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortEnumsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortLambdasOnASingleLine: None
AllowShortNamespacesOnASingleLine: false

# Function calls and parameters
BinPackArguments: false
BinPackParameters: OnePerLine

AllowAllArgumentsOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: true

BreakFunctionDefinitionParameters: false

# Return types
BreakAfterReturnType: Automatic
PenaltyReturnTypeOnItsOwnLine: 1000000

# Parentheses and wrapping
AlignAfterOpenBracket: true

BreakAfterOpenBracketBracedList: false
BreakBeforeCloseBracketBracedList: false

BreakAfterOpenBracketFunction: false
BreakBeforeCloseBracketFunction: false

BreakAfterOpenBracketIf: false
BreakBeforeCloseBracketIf: false

BreakAfterOpenBracketLoop: false
BreakBeforeCloseBracketLoop: false

BreakAfterOpenBracketSwitch: false
BreakBeforeCloseBracketSwitch: false

# Expressions
AlignOperands: Align
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true

# Constructors
BreakConstructorInitializers: BeforeColon
ConstructorInitializerIndentWidth: 4
PackConstructorInitializers: Never

# Inheritance
BreakInheritanceList: BeforeColon

# Pointers and references
DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Left

# Spacing
SpaceBeforeParens: ControlStatements
SpaceAfterCStyleCast: false
SpaceBeforeCpp11BracedList: false
SpaceBeforeSquareBrackets: false
SpaceBeforeAssignmentOperators: true

SpacesInAngles: Never
SpacesInParens: Never
SpacesInSquareBrackets: false

# Initializer lists
Cpp11BracedListStyle: FunctionCall
BinPackLongBracedList: false
InsertTrailingCommas: None

# Alignment
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None

# Align consecutive ///< and /**< ... */ documentation comments.
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0

# Switch statements
IndentCaseLabels: true
IndentCaseBlocks: false

# Access modifiers
AccessModifierOffset: -4
EmptyLineBeforeAccessModifier: LogicalBlock
EmptyLineAfterAccessModifier: Never

# Namespaces
NamespaceIndentation: None
FixNamespaceComments: true

# Includes
SortIncludes: CaseSensitive
IncludeBlocks: Regroup

IncludeCategories:
  - Regex: '^<.*\.h>'
    Priority: 1
  - Regex: '^<.*>'
    Priority: 2
  - Regex: '^".*"'
    Priority: 3

# Definition spacing
SeparateDefinitionBlocks: Leave

# Leave comments and Doxygen formatting alone.
ReflowComments: Always

# Templates and concepts
BreakTemplateDeclarations: Yes
RequiresClausePosition: OwnLine
IndentRequiresClause: true
RequiresExpressionIndentation: OuterScope

# Lambdas
LambdaBodyIndentation: Signature

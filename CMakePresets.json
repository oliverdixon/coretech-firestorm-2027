{
  "version": 6,
  "configurePresets": [
    {
      "name": "tests",
      "hidden": true,
      "cacheVariables": {
        "FIRESTORM_BUILD_TESTING": true
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug-app",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/cmake-build-debug-app"
    },
    {
      "name": "release-app",
      "inherits": "release",
      "binaryDir": "${sourceDir}/cmake-build-release-app"
    },
    {
      "name": "debug-tests",
      "inherits": [
        "debug",
        "tests"
      ],
      "binaryDir": "${sourceDir}/cmake-build-debug-tests"
    },
    {
      "name": "release-tests",
      "inherits": [
        "release",
        "tests"
      ],
      "binaryDir": "${sourceDir}/cmake-build-release-tests"
    }
  ]
}
